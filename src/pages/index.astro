---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import BentoGrid from "../components/BentoGrid.astro";
import ProfileCard from "../components/ProfileCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SkillsCard from "../components/SkillsCard.astro";
import ContactCard from "../components/ContactCard.astro";
import SocialCard from "../components/SocialCard.astro";
import { personalInfo, projects } from "../data/portfolioData";

const categories = ["Web App", "Game", "Tool", "Utility"];

const visibleProjects = projects.filter((project) => project.visible !== false);

const groupedProjects = visibleProjects.reduce((acc, project) => {
  const cat = project.category || "Other";
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(project);
  return acc;
}, {});
---

<Layout title={`${personalInfo.name} | ${personalInfo.role}`} description={personalInfo.description}>
  <Navbar />
  <main class="pt-12 pb-20">
    <BentoGrid>
      <ProfileCard id="home" />
      <SkillsCard id="skills" />
      <ContactCard id="contact" />
      <SocialCard />
    </BentoGrid>

    <div id="projects" class="max-w-7xl mx-auto px-4">
      {
        categories.map((category) =>
          groupedProjects[category] ? (
            <section class="pt-12">
              <div class="flex items-center gap-4 px-2 pb-6">
                <h2 class="text-xl font-bold text-zinc-500 uppercase tracking-[0.3em]">
                  {category}s
                </h2>
                <div class="h-px bg-zinc-800 grow"></div>
                <span class="text-zinc-600 text-xs font-mono">
                  {groupedProjects[category].length.toString().padStart(2, "0")}
                </span>
              </div>
              <div class="grid grid-cols-1 gap-4">
                {groupedProjects[category].map((project) => (
                  <ProjectCard project={project} />
                ))}
              </div>
            </section>
          ) : null
        )
      }
    </div>
  </main>
  <Footer />
</Layout>
