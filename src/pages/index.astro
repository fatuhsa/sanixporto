---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import ProfileCard from "../components/ProfileCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import AboutCard from "../components/AboutCard.astro";
import SkillsCard from "../components/SkillsCard.astro";
import ContactCard from "../components/ContactCard.astro";
import Footer from "../components/Footer.astro";
import { personalInfo, projects } from "../data/portfolioData";

const visibleProjects = projects.filter((project) => project.visible !== false);
---

<Layout title={`${personalInfo.name} | ${personalInfo.role}`} description={personalInfo.description}>
  <Navbar />
  <main>
    <ProfileCard />

    <div class="blade-divider" />

    <section id="work" class="py-16 md:py-24">
      <div class="content-container">
        <div class="reveal mb-10 md:mb-14 flex items-end justify-between gap-6 flex-wrap">
          <div>
            <span class="kicker-chip">01 / Work</span>
            <h2 class="mt-4 font-display text-4xl md:text-5xl tracking-tight text-paper uppercase -skew-x-6">
              Highlight project
            </h2>
            <p class="mt-4 max-w-md text-base leading-[1.55] text-paper/60">
              Swipe through the spreads. Tap View to open.
            </p>
          </div>
        </div>

        <!-- Progress indicator: counter + thin line, not dots -->
        <div class="reveal mb-5 flex items-center gap-4">
          <span
            id="carousel-count"
            class="font-display text-xl text-signal leading-none whitespace-nowrap"
          >
            01 <span class="text-paper/40">/ {String(visibleProjects.length).padStart(2, "0")}</span>
          </span>
          <div class="relative grow h-[3px] bg-line">
            <div
              id="carousel-progress"
              class="absolute inset-y-0 left-0 bg-signal transition-[width] duration-300"
              style="width: calc(100% / 6)"
            />
          </div>
          <div class="hidden sm:flex items-center gap-2">
            <button
              id="carousel-prev"
              class="flex items-center justify-center w-11 h-11 border-2 border-line text-paper/70 hover:text-signal hover:border-signal transition-colors focus-visible:ring-2 focus-visible:ring-signal outline-hidden"
              aria-label="Previous project"
            >
              <Icon name="fa6-solid:arrow-left" class="w-4 h-4" />
            </button>
            <button
              id="carousel-next"
              class="flex items-center justify-center w-11 h-11 border-2 border-line text-paper/70 hover:text-signal hover:border-signal transition-colors focus-visible:ring-2 focus-visible:ring-signal outline-hidden"
              aria-label="Next project"
            >
              <Icon name="fa6-solid:arrow-right" class="w-4 h-4" />
            </button>
          </div>
        </div>

        <div
          id="carousel-track"
          class="reveal carousel-track no-scrollbar flex items-center gap-5 overflow-x-auto pb-2 -mx-5 md:-mx-8 px-5 md:px-8"
        >
          {visibleProjects.map((project, i) => (
            <ProjectCard project={project} index={i} />
          ))}
        </div>

        <div class="mt-12 md:mt-16 border-t-2 border-line pt-6">
          <a
            href="#about"
            class="inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.35em] text-paper/40 hover:text-signal transition-colors focus-visible:ring-2 focus-visible:ring-signal outline-hidden"
          >
            Next: about
            <Icon name="fa6-solid:arrow-down" class="w-4 h-4 animate-bounce" />
          </a>
        </div>
      </div>
    </section>

    <AboutCard />
    <div class="blade-divider" />
    <SkillsCard />
    <div class="blade-divider" />
    <ContactCard />
  </main>
  <Footer />

  <script>
    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!prefersReduced) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("revealed");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
    } else {
      document.querySelectorAll(".reveal").forEach((el) => el.classList.add("revealed"));
    }

    // ---- Editorial carousel ----
    const track = document.getElementById("carousel-track");
    const countEl = document.getElementById("carousel-count");
    const progressEl = document.getElementById("carousel-progress");
    if (track && countEl && progressEl) {
      const slides = Array.from(track.querySelectorAll("[data-slide]"));
      const total = slides.length;

      const update = () => {
        const trackLeft = track.getBoundingClientRect().left;
        const center = trackLeft + track.clientWidth / 2;
        let active = 0;
        let best = Infinity;

        slides.forEach((slide, i) => {
          const rect = slide.getBoundingClientRect();
          const slideCenter = rect.left + rect.width / 2;
          const dist = Math.abs(slideCenter - center);
          if (dist < best) {
            best = dist;
            active = i;
          }

          // parallax: big number drifts slower than the card
          const num = slide.querySelector("[data-parallax]");
          if (num) {
            const drift = (slideCenter - center) * -0.25;
            num.style.transform = `translateX(${drift}px)`;
          }
        });

        countEl.innerHTML = `${String(active + 1).padStart(2, "0")} <span class="text-paper/40">/ ${String(total).padStart(2, "0")}</span>`;
        progressEl.style.width = `${((active + 1) / total) * 100}%`;
      };

      track.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
      update();

      const prev = document.getElementById("carousel-prev");
      const next = document.getElementById("carousel-next");
      const step = () => {
        const slide = slides[0];
        return slide ? slide.getBoundingClientRect().width + 20 : 300;
      };
      prev?.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: prefersReduced ? "auto" : "smooth" }));
      next?.addEventListener("click", () => track.scrollBy({ left: step(), behavior: prefersReduced ? "auto" : "smooth" }));

      // Autoscroll: one slide per second, resumes 3s after user interaction stops
      let autoplay = null;
      let resumeTimer = null;
      let slideIndex = 0;
      let autoScrolling = false;

      const findActiveIndex = () => {
        const trackLeft = track.getBoundingClientRect().left;
        const center = trackLeft + track.clientWidth / 2;
        let active = 0;
        let best = Infinity;
        slides.forEach((slide, i) => {
          const rect = slide.getBoundingClientRect();
          const dist = Math.abs(rect.left + rect.width / 2 - center);
          if (dist < best) {
            best = dist;
            active = i;
          }
        });
        return active;
      };

      const goTo = (i) => {
        slideIndex = (i + total) % total;
        const slide = slides[slideIndex];
        if (slide) {
          autoScrolling = true;
          track.scrollTo({
            left: slide.offsetLeft - (track.clientWidth - slide.clientWidth) / 2,
            behavior: prefersReduced ? "auto" : "smooth",
          });
          window.setTimeout(() => { autoScrolling = false; }, 600);
        }
      };

      const startAutoplay = () => {
        if (prefersReduced || autoplay) return;
        autoplay = setInterval(() => goTo(slideIndex + 1), 1000);
      };
      const stopAutoplay = () => {
        if (autoplay) {
          clearInterval(autoplay);
          autoplay = null;
        }
      };
      const scheduleResume = () => {
        if (prefersReduced) return;
        if (resumeTimer) clearTimeout(resumeTimer);
        resumeTimer = window.setTimeout(() => {
          slideIndex = findActiveIndex();
          startAutoplay();
        }, 3000);
      };

      const onUserInteract = () => {
        if (autoScrolling) return;
        stopAutoplay();
        scheduleResume();
      };

      track.addEventListener("scroll", onUserInteract, { passive: true });
      prev?.addEventListener("click", () => { stopAutoplay(); goTo(slideIndex - 1); scheduleResume(); });
      next?.addEventListener("click", () => { stopAutoplay(); goTo(slideIndex + 1); scheduleResume(); });
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          stopAutoplay();
          if (resumeTimer) clearTimeout(resumeTimer);
        } else {
          scheduleResume();
        }
      });
      startAutoplay();
    }
  </script>
</Layout>