---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ProfileCard from "../components/ProfileCard.astro";
import SkillsCard from "../components/SkillsCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContactCard from "../components/ContactCard.astro";
import { personalInfo, projects } from "../data/portfolioData";

const visibleProjects = projects.filter((project) => project.visible !== false);
---

<Layout title={`${personalInfo.name} | ${personalInfo.role}`} description={personalInfo.description}>
  <Navbar />
  <main>
    <ProfileCard />
    <SkillsCard />

    <section id="projects" class="py-20 md:py-28">
      <div class="content-container">
        <div class="mb-10 md:mb-14 flex items-end justify-between gap-6 flex-wrap">
          <div>
            <span class="kicker">Portfolio</span>
            <h2 class="mt-3 text-4xl md:text-5xl font-bold tracking-tight font-display">
              Projects
            </h2>
            <p class="mt-4 max-w-md text-zinc-400 leading-relaxed">
              Selected things I've built in my free time. The rest lives on my GitHub.
            </p>
          </div>
          <a
            href="https://github.com/fatuhsa"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold border border-zinc-700 text-zinc-200 hover:border-blue-500 hover:text-blue-400 transition-colors shrink-0"
          >
            <Icon name="fa6-brands:github" class="w-4 h-4" />
            View all on GitHub
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
          {visibleProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </div>
    </section>

    <ContactCard />
  </main>
  <Footer />
</Layout>