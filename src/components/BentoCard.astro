---
const { class: className = "", id } = Astro.props;
---

<div
  id={id}
  class:list={[
    "bg-zinc-900/90 border border-zinc-800/80 rounded-3xl p-6 transition-all duration-300 transform-gpu hover:border-zinc-700/80 hover:scale-[1.01] focus-within:ring-2 focus-within:ring-blue-500/50",
    className,
  ]}
>
  <slot />
</div>