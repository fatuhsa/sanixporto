---
import { Icon } from "astro-icon/components";
import { personalInfo, socialLinks } from "../data/portfolioData";

const socials = [
  { name: "github", label: "GitHub", url: socialLinks.github },
  { name: "instagram", label: "Instagram", url: socialLinks.instagram },
  { name: "telegram", label: "Telegram", url: socialLinks.telegram },
];
---

<section id="home" class="relative pt-24 md:pt-40 pb-16 md:pb-24">
  <div class="content-container">
    <div class="reveal">
      <span
        class="inline-flex items-center gap-2 px-3 py-1.5 border border-signal text-signal text-xs font-bold uppercase tracking-[0.25em]"
      >
        <span class="w-1.5 h-1.5 bg-signal" />
        Open for work
      </span>
    </div>

    <h1
      class="reveal mt-4 md:mt-6 font-display text-[40px] leading-[0.95] tracking-tight text-paper uppercase"
    >
      <span class="block -skew-x-6">Sani</span>
      <span class="block -skew-x-6 mt-1">
        <span class="text-signal">X</span> Ansori
      </span>
    </h1>

    <div class="reveal mt-4 md:mt-6 flex items-center gap-3">
      <span class="blade-cut" />
      <span class="text-sm font-bold uppercase tracking-[0.25em] text-paper/60">
        Web dev &amp; game tinkerer
      </span>
    </div>

    <p class="reveal mt-4 md:mt-6 max-w-md text-base leading-[1.55] text-paper/70">
      I build games, tools, and web things for fun — mostly
      <span class="font-accent text-signal">late at night</span>. This is where I
      keep the stuff I'm proud of.
    </p>

    <div class="reveal mt-6 md:mt-8 flex flex-wrap items-center gap-3">
      <a
        href="https://drive.google.com/file/d/19WJloNPi9ZwIyCgdgMyUrAbQvY3dlSmq/view?usp=drive_link"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-signal text-ink px-7 py-4 font-bold text-sm uppercase tracking-wider hover:bg-paper transition-colors focus-visible:ring-2 focus-visible:ring-signal outline-hidden min-h-12"
      >
        <Icon name="fa6-solid:file-arrow-down" class="w-4 h-4" />
        Grab CV
      </a>
      <a
        href="#work"
        class="inline-flex items-center gap-2 px-7 py-4 font-bold text-sm uppercase tracking-wider border border-line text-paper hover:border-signal hover:text-signal transition-colors focus-visible:ring-2 focus-visible:ring-signal outline-hidden min-h-12"
      >
        See the work
      </a>
    </div>

    <div class="reveal mt-8 md:mt-10 flex items-center gap-3">
      {socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.label}
          title={social.label}
          class="flex items-center justify-center w-11 h-11 border border-line text-paper/70 hover:text-signal hover:border-signal transition-colors focus-visible:ring-2 focus-visible:ring-signal outline-hidden"
        >
          <Icon name={`fa6-brands:${social.name}`} class="w-5 h-5" />
        </a>
      ))}
    </div>

    <a
      href="#work"
      class="mt-10 md:mt-14 inline-flex flex-col items-center gap-2 text-[10px] font-bold uppercase tracking-[0.35em] text-paper/40 hover:text-signal transition-colors focus-visible:ring-2 focus-visible:ring-signal outline-hidden"
    >
      Scroll
      <Icon name="fa6-solid:arrow-down" class="w-4 h-4 animate-bounce" />
    </a>
  </div>
</section>