---
import { Icon } from "astro-icon/components";
import { personalInfo, socialLinks } from "../data/portfolioData";

const socials = [
  { name: "github", label: "GitHub", url: socialLinks.github },
  { name: "instagram", label: "Instagram", url: socialLinks.instagram },
  { name: "telegram", label: "Telegram", url: socialLinks.telegram },
];
---

<section id="home" class="relative pt-24 md:pt-40 pb-16 md:pb-24">
  <div class="content-container">
    <!-- Badge tucks under the headline: deliberate overlap -->
    <div class="reveal relative z-10">
      <span
        class="kicker-chip"
      >
        <span class="w-1.5 h-1.5 bg-ink" />
        Open for work
      </span>
    </div>

    <h1
      class="reveal -mt-2 md:-mt-3 font-display text-[44px] leading-[0.8] tracking-tight text-paper uppercase"
    >
      <span class="block -skew-x-6">Sani</span>
      <span class="block -skew-x-6">
        <span class="text-signal">X</span> Ansori
      </span>
    </h1>

    <!-- Tagline sits on a diagonal, overlapping the headline edge -->
    <div class="reveal mt-5 md:mt-6 relative">
      <span class="inline-block -skew-x-12 bg-paper text-ink px-3 py-1 text-sm font-bold uppercase tracking-[0.2em]">
        Web dev &amp; game tinkerer
      </span>
    </div>

    <!-- Full-width thin yellow divider, aligned with the section -->
    <div class="reveal mt-6 md:mt-8 h-[3px] w-full bg-signal" />

    <p class="reveal mt-6 md:mt-7 max-w-md text-base leading-[1.55] text-paper/70">
      I build games, tools, and web things for fun — mostly
      <span class="font-accent text-signal">late at night</span>. This is where I
      keep the stuff I'm proud of.
    </p>

    <div class="reveal mt-7 md:mt-8 flex flex-wrap items-center gap-3">
      <a
        href="https://drive.google.com/file/d/19WJloNPi9ZwIyCgdgMyUrAbQvY3dlSmq/view?usp=drive_link"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative inline-flex items-center gap-2 bg-signal text-ink pl-7 pr-8 py-4 font-bold text-sm uppercase tracking-wider hover:bg-paper transition-colors focus-visible:ring-2 focus-visible:ring-signal outline-hidden min-h-12 -skew-x-6"
      >
        <span class="inline-flex items-center gap-2 skew-x-6">
          <Icon name="fa6-solid:file-arrow-down" class="w-4 h-4" />
          Grab CV
        </span>
        <!-- corner accent -->
        <span class="absolute top-0 right-0 w-3 h-3 bg-ink" />
      </a>
      <a
        href="#work"
        class="inline-flex items-center gap-2 px-7 py-4 font-bold text-sm uppercase tracking-wider border-2 border-line text-paper hover:border-signal hover:text-signal transition-colors focus-visible:ring-2 focus-visible:ring-signal outline-hidden min-h-12"
      >
        See the work
      </a>
    </div>

    <div class="reveal mt-8 md:mt-10 flex items-center gap-3">
      {socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.label}
          title={social.label}
          class="flex items-center justify-center w-11 h-11 border-2 border-line text-paper/70 hover:text-signal hover:border-signal transition-colors focus-visible:ring-2 focus-visible:ring-signal outline-hidden"
        >
          <Icon name={`fa6-brands:${social.name}`} class="w-5 h-5" />
        </a>
      ))}
    </div>

    <a
      href="#work"
      class="mt-10 md:mt-14 inline-flex flex-col items-center gap-2 text-[10px] font-bold uppercase tracking-[0.35em] text-paper/40 hover:text-signal transition-colors focus-visible:ring-2 focus-visible:ring-signal outline-hidden"
    >
      Scroll
      <Icon name="fa6-solid:arrow-down" class="w-4 h-4 animate-bounce" />
    </a>
  </div>
</section>