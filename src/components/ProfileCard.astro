---
import { Icon } from "astro-icon/components";
import { personalInfo } from "../data/portfolioData";
import BentoCard from "./BentoCard.astro";

const { id } = Astro.props;
---

<BentoCard id={id} class="md:col-span-2 md:row-span-2 p-6 md:p-8 flex flex-col justify-between group overflow-hidden relative">
  <div class="z-10">
    <span class="text-blue-500 font-bold tracking-widest uppercase text-xs md:text-sm mb-3 block">
      {personalInfo.role}
    </span>
    <h1 class="text-5xl md:text-7xl font-black tracking-tighter text-white mb-3">
      SANIX
    </h1>
    <p class="text-lg md:text-xl font-medium text-zinc-100 mb-4 max-w-md">
      Building Digital Experiences
    </p>
    <p class="text-sm md:text-base text-zinc-400 leading-relaxed max-w-lg">
      {personalInfo.description}
    </p>
  </div>

  <div class="z-10 flex flex-wrap gap-4 mt-8">
    <a
      href="https://drive.google.com/file/d/19WJloNPi9ZwIyCgdgMyUrAbQvY3dlSmq/view?usp=drive_link"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 bg-white text-black px-6 py-3 rounded-full font-bold hover:bg-zinc-200 transition-colors"
    >
      <Icon name="fa6-solid:file-arrow-down" class="w-4 h-4" />
      Download CV
    </a>
  </div>

  <div class="absolute -bottom-10 -right-10 w-64 h-64 bg-blue-600/10 rounded-full blur-3xl group-hover:bg-blue-600/20 transition-colors" />
</BentoCard>
