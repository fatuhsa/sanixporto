---
import { Icon } from "astro-icon/components";

const { project, index } = Astro.props;

const hasSource = project.sourceUrl && project.sourceUrl !== "#";
const hasLive = project.liveUrl && project.liveUrl !== "#";

const num = String(index + 1).padStart(2, "0");
const offset = index % 2 === 0 ? "md:-translate-y-2" : "md:translate-y-2";
---

<article
  class:list={[
    "carousel-slide group relative shrink-0 w-[75vw] max-w-md snap-center scroll-ml-5 md:scroll-ml-8 transition-all duration-300",
    offset,
  ]}
  data-slide
>
  <div class="relative h-full border-[3px] border-paper/25 bg-ink p-4 md:p-6 hover:border-signal focus-within:border-signal transition-colors">
    <!-- Giant outlined background number -->
    <span
      aria-hidden="true"
      class="absolute -top-1 right-2 font-display text-[72px] md:text-[110px] leading-none text-transparent pointer-events-none select-none"
      style="-webkit-text-stroke: 2px rgb(242 240 235 / 0.14)"
      data-parallax
    >
      {num}
    </span>

    <!-- Preview panel: diagonal clip + thick border -->
    <div class="relative h-24 md:h-44">
      <span
        aria-hidden="true"
        class="absolute inset-0 translate-x-2 translate-y-2 bg-signal/70 clip-slide"
      />
      <div class="relative h-full clip-slide border-[3px] border-paper/30 bg-ink flex items-center justify-center">
        <Icon name={project.icon} class="w-8 h-8 md:w-14 md:h-14 text-signal" />
      </div>
    </div>

    <!-- Category badge: diagonal cut, not pill -->
    <span class="mt-4 inline-block -skew-x-6 bg-signal text-ink px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em]">
      {project.category}
    </span>

    <h3 class="mt-2.5 font-display text-2xl md:text-4xl tracking-tight text-paper uppercase -skew-x-6 leading-[0.9]">
      {project.title}
    </h3>

    <p class="mt-2.5 text-sm md:text-base leading-[1.5] text-paper/70 line-clamp-2">
      {project.description}
    </p>

    <div class="mt-3 flex flex-wrap gap-2">
      {project.techStack?.map((tech) => (
        <span class="px-2 py-1 text-[10px] font-semibold uppercase tracking-wider border border-line text-paper/50">
          {tech}
        </span>
      ))}
    </div>

    <div class="mt-4 flex items-center justify-between gap-3 border-t-2 border-line pt-3.5">
      <div class="flex items-center gap-4">
        {hasLive && (
          <a
            href={project.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group/live inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-signal hover:text-paper transition-colors focus-visible:ring-2 focus-visible:ring-signal rounded-sm outline-hidden min-h-11"
          >
            View
            <Icon name="fa6-solid:arrow-up-right-from-square" class="w-3.5 h-3.5" />
          </a>
        )}
        {hasSource && (
          <a
            href={project.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-paper/60 hover:text-signal transition-colors focus-visible:ring-2 focus-visible:ring-signal rounded-sm outline-hidden min-h-11"
          >
            <Icon name="fa6-brands:github" class="w-4 h-4" />
            Source
          </a>
        )}
      </div>

      <Icon
        name="fa6-solid:arrow-right"
        class="w-4 h-4 text-paper/40 group-hover:text-signal transition-colors shrink-0"
      />
    </div>
  </div>
</article>