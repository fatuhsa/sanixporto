---
import { Icon } from "astro-icon/components";

const { project, index } = Astro.props;

const hasSource = project.sourceUrl && project.sourceUrl !== "#";
const hasLive = project.liveUrl && project.liveUrl !== "#";

const num = String(index + 1).padStart(2, "0");
const rotate = index % 2 === 0 ? "sm:rotate-1" : "sm:-rotate-1";
---

<details
  class:list={[
    "group relative w-full border-2 border-paper/25 bg-ink transition-all duration-200 hover:border-signal focus-within:border-signal",
    rotate,
  ]}
>
  <summary class="list-none cursor-pointer select-none p-5 md:p-7 [&::-webkit-details-marker]:hidden">
    <div class="flex items-start justify-between gap-4">
      <div class="flex items-start gap-4">
        <span class="font-display text-2xl text-signal leading-none mt-0.5">{num}</span>
        <div>
          <div class="flex items-center gap-3 mb-2 flex-wrap">
            <span class="px-2 py-0.5 border border-line text-[10px] font-bold uppercase tracking-[0.2em] text-paper/50">
              {project.category}
            </span>
            {hasLive && (
              <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-signal">
                Live
              </span>
            )}
          </div>
          <h3 class="font-display text-2xl md:text-3xl tracking-tight text-paper uppercase group-hover:text-signal transition-colors">
            {project.title}
          </h3>
        </div>
      </div>
      <Icon
        name="fa6-solid:plus"
        class="w-5 h-5 shrink-0 text-paper/50 group-hover:text-signal transition-transform duration-200 group-open:rotate-45"
      />
    </div>
  </summary>

  <div class="px-5 pb-5 md:px-7 md:pb-7 pt-0 border-t-2 border-line">
    <p class="mt-4 max-w-2xl text-base leading-[1.55] text-paper/70">
      {project.description}
    </p>

    <div class="mt-5 flex flex-wrap gap-2">
      {project.techStack?.map((tech) => (
        <span class="px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider border border-line text-paper/60">
          {tech}
        </span>
      ))}
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-4">
      {hasLive && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm font-bold uppercase tracking-wider text-signal hover:text-paper transition-colors focus-visible:ring-2 focus-visible:ring-signal rounded-sm outline-hidden min-h-11"
        >
          Live demo
          <Icon name="fa6-solid:arrow-up-right-from-square" class="w-3.5 h-3.5" />
        </a>
      )}
      {hasSource && (
        <a
          href={project.sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm font-bold uppercase tracking-wider text-paper/70 hover:text-signal transition-colors focus-visible:ring-2 focus-visible:ring-signal rounded-sm outline-hidden min-h-11"
        >
          <Icon name="fa6-brands:github" class="w-4 h-4" />
          Source
        </a>
      )}
    </div>
  </div>
</details>