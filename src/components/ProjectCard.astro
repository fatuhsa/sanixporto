---
import { Icon } from "astro-icon/components";

const { project } = Astro.props;

const hasSource = project.sourceUrl && project.sourceUrl !== "#";
const hasLive = project.liveUrl && project.liveUrl !== "#";

const categoryStyles = {
  "Game": { badge: "text-violet-300 bg-violet-500/10 border-violet-500/30", icon: "text-violet-400 group-hover:border-violet-500/40" },
  "Web App": { badge: "text-blue-300 bg-blue-500/10 border-blue-500/30", icon: "text-blue-400 group-hover:border-blue-500/40" },
  "Tool": { badge: "text-emerald-300 bg-emerald-500/10 border-emerald-500/30", icon: "text-emerald-400 group-hover:border-emerald-500/40" },
  "Utility": { badge: "text-amber-300 bg-amber-500/10 border-amber-500/30", icon: "text-amber-400 group-hover:border-amber-500/40" },
};

const style = categoryStyles[project.category] || categoryStyles["Tool"];
---

<article class="group relative flex flex-col rounded-2xl border border-zinc-800/80 bg-zinc-900/50 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-zinc-600/80 hover:bg-zinc-900">
  <div class="flex items-start justify-between gap-4 mb-5">
    <div
      class:list={[
        "w-12 h-12 rounded-xl flex items-center justify-center bg-zinc-800/80 border border-zinc-700/60 transition-all duration-300 group-hover:scale-110",
        style.icon,
      ]}
    >
      {project.icon && <Icon name={project.icon} class="w-6 h-6" />}
    </div>
    <span
      class:list={[
        "inline-flex px-2.5 py-1 rounded-full border text-[10px] font-bold uppercase tracking-wider shrink-0",
        style.badge,
      ]}
    >
      {project.category}
    </span>
  </div>

  <h3 class="text-xl font-bold tracking-tight text-white font-display">
    {project.title}
  </h3>
  <p class="mt-2.5 text-sm text-zinc-400 leading-relaxed line-clamp-3 flex-1 mb-6">
    {project.description}
  </p>

  <div class="flex flex-wrap gap-2 mb-6">
    {project.techStack?.map((tech) => (
      <span
        class="px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider bg-zinc-800/80 text-zinc-400 rounded-full border border-zinc-700/60"
      >
        {tech}
      </span>
    ))}
  </div>

  <div class="flex items-center gap-3 border-t border-zinc-800/80 pt-4">
    {hasLive && (
      <a
        href={project.liveUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-blue-400 hover:text-blue-300 transition-colors focus-visible:ring-2 focus-visible:ring-blue-400 rounded-md outline-hidden"
      >
        Live demo
        <Icon name="fa6-solid:arrow-up-right-from-square" class="w-3 h-3" />
      </a>
    )}
    {hasSource && (
      <a
        href={project.sourceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-zinc-400 hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-zinc-400 rounded-md outline-hidden"
      >
        <Icon name="fa6-brands:github" class="w-4 h-4" />
        Source
      </a>
    )}
  </div>
</article>