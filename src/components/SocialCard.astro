---
import { Icon } from "astro-icon/components";
import { socialLinks } from "../data/portfolioData";
import BentoCard from "./BentoCard.astro";

const socials = [
  { name: "github", url: socialLinks.github },
  { name: "instagram", url: socialLinks.instagram },
  { name: "telegram", url: socialLinks.telegram },
];
---

<BentoCard class="md:col-span-1 md:row-span-1 flex flex-wrap gap-6 items-center justify-center">
  {socials.map((social) => (
    <a
      href={social.url}
      target="_blank"
      rel="noopener noreferrer"
      class="p-2.5 rounded-xl text-zinc-400 hover:text-white hover:bg-zinc-800/60 transition-all focus-visible:ring-2 focus-visible:ring-blue-500 outline-none"
      aria-label={social.name}
    >
      <Icon name={`fa6-brands:${social.name}`} class="w-7 h-7" />
    </a>
  ))}
</BentoCard>
