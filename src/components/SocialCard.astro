---
import { Icon } from "astro-icon/components";
import { socialLinks } from "../data/portfolioData";
import BentoCard from "./BentoCard.astro";

const socials = [
  { name: "github", label: "GitHub", url: socialLinks.github, color: "#ffffff" },
  { name: "instagram", label: "Instagram", url: socialLinks.instagram, color: "#e1306c" },
  { name: "telegram", label: "Telegram", url: socialLinks.telegram, color: "#2aabee" },
];
---

<BentoCard class="md:col-span-1 md:row-span-1 flex flex-col justify-center gap-4">
  <span class="text-xs uppercase text-zinc-500 font-semibold tracking-wider">
    Find me on
  </span>
  <div class="flex items-center gap-3">
    {socials.map((social) => (
      <a
        href={social.url}
        target="_blank"
        rel="noopener noreferrer"
        class="p-3 rounded-2xl text-zinc-400 hover:text-white hover:bg-zinc-800/80 border border-transparent hover:border-zinc-700 transition-all duration-300 hover:-translate-y-1 flex items-center justify-center focus-visible:ring-2 focus-visible:ring-blue-500 outline-none"
        aria-label={social.name}
        title={social.label}
      >
        <Icon name={`fa6-brands:${social.name}`} class="w-11 h-11" />
      </a>
    ))}
  </div>
</BentoCard>