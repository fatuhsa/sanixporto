---
import { Icon } from "astro-icon/components";
import { personalInfo, socialLinks } from "../data/portfolioData";

const currentYear = new Date().getFullYear();

const socials = [
  { name: "github", label: "GitHub", url: socialLinks.github },
  { name: "instagram", label: "Instagram", url: socialLinks.instagram },
  { name: "facebook", label: "Facebook", url: socialLinks.facebook },
  { name: "youtube", label: "YouTube", url: socialLinks.youtube },
  { name: "telegram", label: "Telegram", url: socialLinks.telegram },
];
---

<footer class="border-t border-line bg-ink">
  <div class="content-container py-12 flex flex-col md:flex-row items-center justify-between gap-8">
    <a href="#home" class="font-display text-2xl tracking-tight hover:opacity-80 transition-opacity">
      SANI<span class="text-signal">X</span>
    </a>

    <div class="flex items-center gap-2">
      {socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.label}
          title={social.label}
          class="flex items-center justify-center w-11 h-11 border border-line text-paper/60 hover:text-signal hover:border-signal transition-colors focus-visible:ring-2 focus-visible:ring-signal outline-hidden"
        >
          <Icon name={`fa6-brands:${social.name}`} class="w-5 h-5" />
        </a>
      ))}
    </div>

    <p class="text-xs text-paper/40 font-medium tracking-wide">
      &copy; {currentYear} {personalInfo.name} &middot; Built by SaniX v3.0.0
    </p>
  </div>
</footer>