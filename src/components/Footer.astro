---
import { Icon } from "astro-icon/components";
import { personalInfo, socialLinks } from "../data/portfolioData";

const currentYear = new Date().getFullYear();

const socials = [
  { name: "github", label: "GitHub", url: socialLinks.github },
  { name: "instagram", label: "Instagram", url: socialLinks.instagram },
  { name: "facebook", label: "Facebook", url: socialLinks.facebook },
  { name: "youtube", label: "YouTube", url: socialLinks.youtube },
  { name: "telegram", label: "Telegram", url: socialLinks.telegram },
];
---

<footer class="border-t border-zinc-800/60 bg-zinc-950/50">
  <div class="content-container py-12 flex flex-col md:flex-row items-center justify-between gap-8">
    <a href="#home" class="font-display font-bold text-2xl tracking-tighter hover:opacity-80 transition-opacity">
      SANI<span class="text-zinc-500">X</span>
    </a>

    <div class="flex items-center gap-2">
      {socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.label}
          title={social.label}
          class="p-2.5 rounded-xl text-zinc-400 hover:text-white hover:bg-zinc-800/80 transition-colors focus-visible:ring-2 focus-visible:ring-blue-500 outline-hidden"
        >
          <Icon name={`fa6-brands:${social.name}`} class="w-5 h-5" />
        </a>
      ))}
    </div>

    <p class="text-xs text-zinc-500 font-medium">
      &copy; {currentYear} {personalInfo.name} &middot; Built by SaniX v2.1.0
    </p>
  </div>
</footer>