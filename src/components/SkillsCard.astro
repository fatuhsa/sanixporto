---
import { Icon } from "astro-icon/components";
import { skills } from "../data/portfolioData";
---

<section id="skills" class="py-20 md:py-28 border-t border-line">
  <div class="content-container">
    <div class="reveal mb-10 md:mb-14">
      <span class="kicker">03 / Stack</span>
      <h2 class="mt-3 font-display text-4xl md:text-5xl tracking-tight text-paper uppercase -skew-x-3">
        Tools I use
      </h2>
    </div>

    <ol class="grid grid-cols-2 gap-3 md:gap-4">
      {skills.map((skill, i) => (
        <li class="reveal flex items-center gap-3 border-2 border-paper/25 p-4 hover:border-signal hover:bg-paper/5 transition-colors">
          <span class="font-display text-sm text-signal leading-none shrink-0">
            {String(i + 1).padStart(2, "0")}
          </span>
          <Icon name={skill.icon} class="w-5 h-5 shrink-0 text-paper/60" />
          <span class="font-bold uppercase tracking-wide text-sm md:text-base truncate">
            {skill.name}
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>