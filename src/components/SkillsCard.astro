---
import { Icon } from "astro-icon/components";
import { skills } from "../data/portfolioData";
---

<section id="skills" class="py-20 md:py-28">
  <div class="content-container">
    <div class="mb-10 md:mb-14">
      <span class="kicker">Toolbox</span>
      <h2 class="mt-3 text-4xl md:text-5xl font-bold tracking-tight font-display">
        Skills
      </h2>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
      {skills.map((skill) => (
        <div
          class="group flex flex-col items-center gap-3 rounded-2xl border border-zinc-800/80 bg-zinc-900/50 py-7 px-4 text-center transition-all duration-300 hover:-translate-y-1 hover:border-zinc-600/80 hover:bg-zinc-900"
        >
          <div
            class="w-12 h-12 rounded-xl flex items-center justify-center bg-zinc-800/80 border border-zinc-700/60 transition-transform duration-300 group-hover:scale-110"
          >
            <Icon
              name={skill.icon}
              class="w-7 h-7"
              style={`color: ${skill.color}`}
            />
          </div>
          <span class="text-sm font-medium text-zinc-300 group-hover:text-white transition-colors">
            {skill.name}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>