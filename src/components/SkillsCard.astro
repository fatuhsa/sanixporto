---
import { Icon } from "astro-icon/components";
import { skills } from "../data/portfolioData";
import BentoCard from "./BentoCard.astro";

const { id } = Astro.props;
---

<BentoCard id={id} class="md:col-span-2 md:row-span-1 flex flex-col justify-between">
  <div>
    <h3 class="text-xs uppercase text-zinc-500 font-semibold tracking-wider mb-4">
      Tech Stack
    </h3>
    <div class="flex flex-wrap gap-3">
      {skills.map((skill) => (
        <div
          class="flex items-center gap-2 px-3 py-2 bg-zinc-800 rounded-xl border border-transparent hover:border-zinc-700 transition-all group"
        >
          <Icon name={skill.icon} class="w-5 h-5 text-zinc-400 group-hover:text-white transition-colors" />
          <span class="text-sm font-medium text-zinc-300 group-hover:text-white">
            {skill.name}
          </span>
        </div>
      ))}
    </div>
  </div>
</BentoCard>
