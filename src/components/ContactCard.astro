---
import { Icon } from "astro-icon/components";
import { personalInfo, socialLinks } from "../data/portfolioData";

const channels = [
  {
    label: "Email",
    value: personalInfo.email,
    href: `mailto:${personalInfo.email}`,
    icon: "fa6-solid:envelope",
  },
  {
    label: "Telegram",
    value: "@suradirajayadiningrat",
    href: socialLinks.telegram,
    icon: "fa6-brands:telegram",
    external: true,
  },
];
---

<section id="contact" class="pb-24 md:pb-32">
  <div class="content-container">
    <div class="mb-10 md:mb-14">
      <span class="kicker">Contact</span>
      <h2 class="mt-3 text-4xl md:text-5xl font-bold tracking-tight font-display">
        Let's talk
      </h2>
      <p class="mt-4 max-w-md text-zinc-400 leading-relaxed">
        Have a project in mind or just want to say hi? Reach out directly and I'll get back to you.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 max-w-3xl">
      {channels.map((channel) => (
        <a
          href={channel.href}
          target={channel.external ? "_blank" : undefined}
          rel={channel.external ? "noopener noreferrer" : undefined}
          class="group flex items-center gap-4 rounded-2xl border border-zinc-800/80 bg-zinc-900/50 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-blue-500/60 hover:bg-zinc-900 focus-visible:ring-2 focus-visible:ring-blue-500 outline-hidden"
        >
          <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-zinc-800/80 border border-zinc-700/60 text-blue-400 transition-colors group-hover:scale-110">
            <Icon name={channel.icon} class="w-6 h-6" />
          </div>
          <div class="min-w-0">
            <span class="block text-[10px] font-bold uppercase tracking-widest text-zinc-500">
              {channel.label}
            </span>
            <span class="block text-lg font-semibold text-white truncate">{channel.value}</span>
          </div>
          <Icon
            name="fa6-solid:arrow-right"
            class="w-4 h-4 text-zinc-600 group-hover:text-blue-400 group-hover:translate-x-1 transition-all duration-300 ml-auto shrink-0"
          />
        </a>
      ))}
    </div>
  </div>
</section>