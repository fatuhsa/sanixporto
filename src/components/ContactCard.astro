---
import { Icon } from "astro-icon/components";
import { personalInfo, socialLinks } from "../data/portfolioData";

const channels = [
  {
    label: "Email",
    value: personalInfo.email,
    href: `mailto:${personalInfo.email}`,
    icon: "fa6-solid:envelope",
  },
  {
    label: "Telegram",
    value: "@suradirajayadiningrat",
    href: socialLinks.telegram,
    icon: "fa6-brands:telegram",
    external: true,
  },
];
---

<section id="contact" class="py-16 md:py-24">
  <div class="content-container">
    <div class="reveal mb-10 md:mb-14">
      <span class="kicker-chip">04 / Contact</span>
      <h2 class="mt-4 font-display text-4xl md:text-5xl tracking-tight text-paper uppercase -skew-x-6">
        Say hi
      </h2>
      <p class="mt-4 max-w-md text-base leading-[1.55] text-paper/70">
        Got an idea, a project, or just want to talk shop? My inbox is open.
      </p>
    </div>

    <a
      href={`mailto:${personalInfo.email}`}
      class="reveal group inline-flex items-center justify-center gap-3 bg-signal text-ink px-6 py-5 font-display text-2xl md:text-3xl uppercase tracking-tight hover:bg-paper transition-colors focus-visible:ring-2 focus-visible:ring-signal outline-hidden w-full -skew-x-6"
    >
      <span class="inline-flex items-center gap-3 skew-x-6">
        Start a conversation
        <Icon
          name="fa6-solid:arrow-right"
          class="w-6 h-6 group-hover:translate-x-1.5 transition-transform duration-200"
        />
      </span>
    </a>

    <div class="mt-6 grid gap-3 md:grid-cols-2">
      {channels.map((channel) => (
        <a
          href={channel.href}
          target={channel.external ? "_blank" : undefined}
          rel={channel.external ? "noopener noreferrer" : undefined}
          class="flex items-center gap-4 border-2 border-paper/25 p-5 hover:border-signal hover:bg-paper/5 transition-colors focus-visible:ring-2 focus-visible:ring-signal outline-hidden"
        >
          <div class="flex items-center justify-center w-11 h-11 border-2 border-line text-signal shrink-0">
            <Icon name={channel.icon} class="w-5 h-5" />
          </div>
          <div class="min-w-0">
            <span class="block text-[10px] font-bold uppercase tracking-[0.25em] text-paper/50">
              {channel.label}
            </span>
            <span class="block text-base font-bold text-paper truncate">{channel.value}</span>
          </div>
          <Icon
            name="fa6-solid:arrow-right"
            class="w-4 h-4 text-paper/40 group-hover:text-signal ml-auto shrink-0 transition-colors"
          />
        </a>
      ))}
    </div>
  </div>
</section>