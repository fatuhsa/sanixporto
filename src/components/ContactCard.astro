---
import { Icon } from "astro-icon/components";
import { personalInfo } from "../data/portfolioData";
import BentoCard from "./BentoCard.astro";

const { id } = Astro.props;
---

<BentoCard id={id} class="md:col-span-1 md:row-span-1 flex flex-col justify-between">
  <div>
    <h3 class="text-2xl font-bold text-white mb-2">Let's talk?</h3>
    <p class="text-zinc-400 text-sm leading-relaxed">
      Have a project in mind or just want to say hi?
    </p>
  </div>
  <a
    href={`mailto:${personalInfo.email}`}
    class="w-full flex items-center justify-center gap-2 bg-white text-black py-3 rounded-xl font-bold hover:bg-zinc-200 transition-colors mt-4"
  >
    <Icon name="fa6-solid:paper-plane" class="w-4 h-4" />
    Contact Me
  </a>
</BentoCard>
