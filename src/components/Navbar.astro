---
import { Icon } from "astro-icon/components";
import { socialLinks } from "../data/portfolioData";

const navLinks = [
  { num: "01", name: "Work", href: "#work" },
  { num: "02", name: "About", href: "#about" },
  { num: "03", name: "Stack", href: "#skills" },
  { num: "04", name: "Contact", href: "#contact" },
];

const socials = [
  { name: "github", url: socialLinks.github },
  { name: "instagram", url: socialLinks.instagram },
  { name: "telegram", url: socialLinks.telegram },
];
---

<nav
  id="site-nav"
  class="fixed top-0 inset-x-0 z-50 bg-ink/85 backdrop-blur-md border-b border-line"
>
  <div class="content-container flex items-center justify-between gap-6 min-h-16">
    <a
      href="#home"
      class="font-display text-2xl tracking-tight hover:opacity-80 transition-opacity focus-visible:ring-2 focus-visible:ring-signal rounded-sm outline-hidden py-2"
      aria-label="Back to top"
    >
      SANI<span class="text-signal">X</span>
    </a>

    <div class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-semibold text-paper/70 hover:text-signal transition-colors focus-visible:ring-2 focus-visible:ring-signal rounded-sm outline-hidden py-3"
        >
          <span class="text-signal text-[10px] font-bold mr-1.5">{link.num}</span>
          {link.name}
        </a>
      ))}
    </div>

    <button
      id="menu-toggle"
      class="md:hidden flex items-center justify-center w-11 h-11 border border-line text-paper hover:border-signal hover:text-signal transition-colors focus-visible:ring-2 focus-visible:ring-signal outline-hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="menu-panel"
    >
      <Icon name="fa6-solid:bars" class="w-5 h-5" />
    </button>
  </div>
</nav>

<!-- Fullscreen menu overlay -->
<div
  id="menu-overlay"
  class="md:hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] transition-opacity duration-200 opacity-0 pointer-events-none"
  aria-hidden="true"
/>

<aside
  id="menu-panel"
  class="md:hidden fixed top-0 inset-x-0 h-full bg-ink z-[70] border-b border-signal transition-transform duration-300 ease-[cubic-bezier(0.2,1.4,0.3,1)] -translate-y-full"
  aria-hidden="true"
>
  <div class="flex flex-col h-full px-5 py-4">
    <div class="flex items-center justify-between">
      <span class="font-display text-2xl tracking-tight">
        SANI<span class="text-signal">X</span>
      </span>
      <button
        id="menu-close"
        class="flex items-center justify-center w-11 h-11 border border-line text-paper hover:border-signal hover:text-signal transition-colors"
        aria-label="Close menu"
      >
        <Icon name="fa6-solid:xmark" class="w-5 h-5" />
      </button>
    </div>

    <div class="grow flex flex-col justify-center">
      <span class="kicker mb-8">Navigation</span>
      <nav class="flex flex-col">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="group flex items-baseline gap-4 border-b border-line py-5 font-display text-5xl tracking-tight text-paper hover:text-signal transition-colors"
          >
            <span class="text-sm font-bold text-signal">{link.num}</span>
            {link.name}
          </a>
        ))}
      </nav>
    </div>

    <div class="pt-6 pb-2">
      <span class="kicker block mb-4">Socials</span>
      <div class="flex gap-3">
        {socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center w-11 h-11 border border-line text-paper/80 hover:text-signal hover:border-signal transition-colors"
            aria-label={social.name}
          >
            <Icon name={`fa6-brands:${social.name}`} class="w-5 h-5" />
          </a>
        ))}
      </div>
    </div>
  </div>
</aside>

<script>
  const overlay = document.getElementById("menu-overlay");
  const panel = document.getElementById("menu-panel");
  const toggler = document.getElementById("menu-toggle");
  const closer = document.getElementById("menu-close");

  const setMenu = (open) => {
    toggler?.setAttribute("aria-expanded", String(open));
    toggler?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    overlay?.classList.toggle("opacity-100", open);
    overlay?.classList.toggle("opacity-0", !open);
    overlay?.classList.toggle("pointer-events-auto", open);
    overlay?.classList.toggle("pointer-events-none", !open);
    panel?.classList.toggle("-translate-y-full", !open);
    panel?.classList.toggle("translate-y-0", open);
    panel?.setAttribute("aria-hidden", String(!open));
    document.body.style.overflow = open ? "hidden" : "";
  };

  toggler?.addEventListener("click", () => setMenu(true));
  closer?.addEventListener("click", () => setMenu(false));
  overlay?.addEventListener("click", () => setMenu(false));
  panel?.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });
</script>